<% layout('layouts/main') -%>

<div class="bg-white p-8 rounded-lg shadow-xl w-full">
  <h2 class="text-3xl font-bold text-blue-600 mb-6">Welcome to Your Notes!</h2>

  <p class="text-gray-700 mb-8">
    This is your personal space to capture ideas, thoughts, and reminders.
    Get started by creating your first note.
  </p>

  <div class="text-center mb-8">
    <a href="/notes/new" class="bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg text-lg shadow-md hover:shadow-lg transition duration-150 ease-in-out">
      Create New Note
    </a>
  </div>

  <div class="mt-10">
    <h3 class="text-2xl font-semibold text-gray-700 mb-4">Your Notes</h3>
    <div class="border border-gray-200 p-6 rounded-lg bg-gray-50">
      <p class="text-gray-500 italic">
        You don't have any notes yet. Click the "Create New Note" button to add one!
        Future notes will be displayed here.
      </p>
    </div>
  </div>
</div>
