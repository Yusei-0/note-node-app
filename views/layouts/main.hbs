<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/output.css"> <!- Link to Tailwind CSS output ->
</head>
<body class="bg-slate-100 text-slate-800 font-sans flex flex-col min-h-screen">
  <header class="bg-sky-600 text-white p-4 shadow-lg sticky top-0 z-50">
    <div class="container mx-auto flex justify-between items-center">
      <a href="/" class="text-2xl font-bold hover:text-sky-200 transition-colors">NotesApp</a>
      <nav>
        <a href="/" class="px-4 py-2 hover:bg-sky-700 rounded-md transition-colors">Home</a>
        <a href="/login" class="px-4 py-2 hover:bg-sky-700 rounded-md transition-colors">Login</a>
        <a href="/notes/new" class="px-4 py-2 bg-green-500 hover:bg-green-600 rounded-md font-semibold shadow-md hover:shadow-lg transition-all">Create Note</a>
      </nav>
    </div>
  </header>

  <main class="container mx-auto p-6 mt-8 flex-grow">
    {{{body}}}
  </main>

  <footer class="bg-slate-800 text-slate-200 p-6 text-center mt-12">
    <p>&copy; 2023 NotesApp. Built with Handlebars & Tailwind CSS.</p>
  </footer>
</body>
</html>
